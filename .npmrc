# Workaround for Hugo >= 0.161 (gohugoio/hugo#14852): pnpm's isolated linker
# creates shell wrapper scripts in node_modules/.bin that Hugo's Node.js
# script resolution cannot parse ("binary postcss is not a Node.js script").
# The hoisted linker produces npm-style symlinks instead. Remove once
# gohugoio/hugo#14856 (or equivalent) ships in a release.
node-linker=hoisted
